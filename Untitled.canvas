		{"id":"f6d3bd6b3099b58d","x":-1879,"y":-1120,"width":970,"height":1248,"type":"text","text":"```dataviewjs\n// Format matching your daily note file names\nconst today = moment().format(\"YYYY/MM/YYYY-MM-DD\");\n\n// If your notes are in a folder, add it here (e.g., \"Daily Notes/\" or \"\")\nconst folder = \"Daily Notes/\"; \nconst path = `${folder}${today}.md`;\n\nconst file = app.vault.getAbstractFileByPath(path);\n\nif (file) {\n    // 1. Clickable link header pointing to the file\n    dv.header(3, dv.fileLink(file.path, false, `📅 Open Today's Note (${today})`));\n    \n    // 2. Render note content\n    const content = await app.vault.read(file);\n    dv.paragraph(content);\n} else {\n    dv.paragraph(`*Daily note for [[${today}]] does not exist yet.*`);\n}\n```\n\n"}
